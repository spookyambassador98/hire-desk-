HIRE_DESK_ACCESS_CODE=APEX-HIRE

# MAX LIVE harvest engine
HIRE_RUN_TARGET=80
HIRE_DAILY_QUOTA=40
HIRE_SEGMENT_BATCH=25
HIRE_PARSER_MODE=live

# Sources (0 = off)
SOURCES_REMOTIVE=1
SOURCES_ARBEITNOW=1
SOURCES_REMOTEOK=1
SOURCES_GREENHOUSE=1
SOURCES_ASHBY=1
SOURCES_HTML=1
SOURCES_LINKEDIN_IMPORT=1

# Comma-separated board tokens
GREENHOUSE_BOARDS=stripe,notion,figma,vercel,linear
ASHBY_BOARDS=openai,anthropic,vercel

# Optional HTML career pages
# CAREER_HTML_URLS=https://example.com/careers

# Proxies (required for Indeed HTML)
# PROXY_URLS=http://user:pass@host:port

# Auto: external cron → POST /api/harvest/cron
# HARVEST_CRON_SECRET=change-me
# HARVEST_INTERNAL_BASE=http://127.0.0.1:3011
# (HARVEST_AUTO_CRON logs a hint only — use HTTP cron like Lead Desk Render)

# LinkedIn import only (file or URL) — no SN scrape
# LINKEDIN_IMPORT_FILE=data/linkedin_imports.json
# LINKEDIN_EXPORT_URL=
