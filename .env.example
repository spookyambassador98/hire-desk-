# Required — app gate + /api/auth/unlock (no default in code)
HIRE_DESK_ACCESS_CODE=

# local (default) | firebase
# HIRE_STORAGE=firebase
# Path to service account JSON from Firebase console (gitignored)
# FIREBASE_SERVICE_ACCOUNT_PATH=secrets/hire-deck-firebase-adminsdk.json
# Or inline (Render — recommended):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=   # paste with \n newlines or quoted JSON string
# Or single secret on Render:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# MAX LIVE harvest engine
HIRE_RUN_TARGET=80
HIRE_DAILY_QUOTA=40
HIRE_SEGMENT_BATCH=25
HIRE_PARSER_MODE=live

# Sources (0 = off)
SOURCES_REMOTIVE=1
SOURCES_ARBEITNOW=1
SOURCES_REMOTEOK=1
SOURCES_HACKERNEWS=1
SOURCES_GITHUB=1
SOURCES_GREENHOUSE=1
SOURCES_ASHBY=1
SOURCES_LEVER=1
SOURCES_WORKABLE=1
SOURCES_SMARTRECRUITERS=1
SOURCES_HTML=1
SOURCES_TELEGRAM=0
SOURCES_LINKEDIN_IMPORT=1

# Optional GitHub PAT (60 req/h without · 5000/h with)
# GITHUB_TOKEN=

# Board / company lists (comma or newline)
GREENHOUSE_BOARDS=stripe,notion,figma,vercel,linear,airbnb,dropbox,coinbase
ASHBY_BOARDS=openai,anthropic,vercel,linear,ramp
LEVER_SITES=spotify,shopify,discord,netflix,robinhood,coinbase,rippling,scale
# Slugs from apply.workable.com/{slug}
# WORKABLE_ACCOUNTS=
SMARTRECRUITERS_COMPANIES=Visa,Wise,Revolut,Spotify

# Telegram public channels (@ optional) — use PROXY_URLS + slow poll
# TELEGRAM_CHANNELS=remote_jobs,ukraine_it_jobs
# TELEGRAM_FETCH_DELAY_MS=2200

# Optional HTML career pages
# CAREER_HTML_URLS=https://example.com/careers

# Proxies (Lead Desk style) — REQUIRED for heavy MAX LIVE / Indeed HTML
# 1) Deploy cloudflare/hire-proxy-worker.js
# 2) PROXY_URLS=https://YOUR.workers.dev
# 3) PROXY_GATEWAY_SECRET=same as Worker PROXY_SECRET
# Optional residential: PROXY_URLS=http://user:pass@host:port,https://worker...
PROXY_URLS=
PROXY_GATEWAY_SECRET=
PROXY_GATEWAYS=1
PROXY_BLOCK_CF_WORKER=0
# PROXY_ALLOW_CF_WORKER=1
# Soft caps when PROXY_URLS empty (protect Render IP)
HIRE_RUN_TARGET_NO_PROXY=35
HIRE_DIRECT_GAP_MS=450
HIRE_PROXY_GAP_MS=120
HIRE_FETCH_RETRIES=3

# Auto: external cron → POST /api/harvest/cron
# HARVEST_CRON_SECRET=change-me
# HARVEST_INTERNAL_BASE=http://127.0.0.1:3011

# Keep-alive (Render free sleeps ~15m). Hit GET /api/ping every 10–14m.
# Options: Render cron hire-desk-keepalive, or free UptimeRobot / cron-job.org
# → https://hire-desk.onrender.com/api/ping


# LinkedIn import only (file or URL) — no SN scrape
# LINKEDIN_IMPORT_FILE=data/linkedin_imports.json
# LINKEDIN_EXPORT_URL=
